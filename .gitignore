# Dependencies
node_modules
.pnp
.pnp.js

# Build output
dist
dist-ssr
*.local

# Environment (never commit real env files; the example is tracked)
.env
.env.*
!.env.example

# Secrets / signing — NEVER commit these
*.keystore
*.jks
android/key.properties
android/app/release
google-services.json
GoogleService-Info.plist

# Capacitor copies the web build into the native projects
android/app/src/main/assets/public
ios/App/App/public

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.sw?
