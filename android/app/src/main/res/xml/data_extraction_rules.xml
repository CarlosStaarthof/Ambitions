<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+). The app's own JSON export is the only supported backup,
     so nothing is allowed to leave the device via cloud backup or device transfer.
     This also keeps any stored provider API keys out of Google's backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
